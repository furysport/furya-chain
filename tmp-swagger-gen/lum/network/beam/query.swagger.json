            "required": false,
            "type": "string",
            "enum": [
              "UNSPECIFIED",
              "OPEN",
              "CANCELED",
              "CLOSED"
            ],
            "default": "UNSPECIFIED"
          }
        ],
        "tags": [
          "Query"
        ]
