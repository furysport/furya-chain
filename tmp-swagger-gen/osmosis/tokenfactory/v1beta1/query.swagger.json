          },
          "description": "DenomCreationFee defines the fee to be charged on the creation of a new\ndenom. The fee is drawn from the MsgCreateDenom's sender account, and\ntransferred to the community pool."
        },
        "denom_creation_gas_consume": {
          "type": "string",
          "format": "uint64",
          "description": "DenomCreationGasConsume defines the gas cost for creating a new denom.\nThis is intended as a spam deterrence mechanism.\n\nSee: https://github.com/CosmWasm/token-factory/issues/11"
        }
